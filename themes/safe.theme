# ptop's built-in `safe` palette, as a theme file.
#
# Copy it to ~/.config/ptop/themes/mine.theme and change what you like.
# Every line is optional: a theme inherits `safe` for anything it does
# not name, so overriding two colours is two lines.
#
# Colours are `#rrggbb`, a 256-colour index like `80`, or an ANSI name
# like `cyan`. Generated by the `write_builtin_theme_files` test.

ok           = #5ccfe6
warn         = #ffd580
critical     = #ff6666
series_cpu   = #7a7ae6
series_mem   = #b48ead
chrome       = #505050
text         = #cccccc
text_dim     = #808080
selection_bg = #3a3a3a
live         = #5ccfe6
